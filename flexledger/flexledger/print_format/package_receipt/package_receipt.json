 "html": "<h1 class=\"text-center\">Package Receipt</h1>\r\n\r\n    {% if doc.status == \"Expired\" %}\r\n        <h3 class=\"text-center\">Package Expired!!!!</h3>\r\n    {% endif %}\r\n        {% set member = frappe.get_doc(\"Member\",doc.member) %}\r\n    <table class=\"table table-bordered\">\r\n        <tbody>\r\n            <tr>\r\n                <th>Name</th>\r\n                <td>{{ member.member_name }}</td>\r\n            </tr>\r\n            <tr>\r\n                <th>Total Credits</th>\r\n                <td>{{ doc.total_credits }}</td>\r\n            </tr>\r\n            <tr>\r\n                <th>Credits Used</th>\r\n                <td>{{ doc.credits_used }}</td>\r\n            </tr>\r\n            <tr>\r\n                <th><strong>Credits Remaining</strong></th>\r\n                <td><strong>{{ doc.credits_remaining }}</strong></td>\r\n            </tr>\r\n            <tr>\r\n                <th>Amount Paid</th>\r\n                <td>{{ doc.amount_paid }}</td>\r\n            </tr>\r\n        </tbody>\r\n    </table>\r\n\r\n\r\n<h3 class = \"text-center\"><strong>Summary : </strong>{{doc.print_summary}}</h3>\r\n",
